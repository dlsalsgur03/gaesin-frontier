# Node로 백엔드를 직접 실행할 때 쓰는 값. `node scripts/setup-env.mjs`가 이 파일로 backend/.env를 만든다.
# DB는 `docker compose up -d db`(호스트 포트 5433). 계정은 compose 기본값과 같다.
DATABASE_URL=postgresql://gaesin:gaesin_local@localhost:5433/gaesin_frontier
# 32바이트 이상 무작위 값.
JWT_SECRET=
PORT=3001
# 프론트엔드 주소. 쉼표로 여러 개 지정할 수 있다.
CORS_ORIGIN=http://localhost:3000
# 업로드 파일 저장 폴더. 비우면 backend/uploads를 쓴다.
# UPLOAD_DIR=
